#!/usr/bin/env node
// Merges the fork's translations from locale-overrides/ over the upstream
// translations cloned into locale/. Keys from the overrides win; keys that
// only exist upstream are kept, so new upstream strings still get the
// community translation until the override catches up.
const fs = require('fs');
const path = require('path');

const clientDir = path.join(__dirname, '..');
const overridesDir = path.join(clientDir, 'locale-overrides');
const localeDir = path.join(clientDir, 'locale');

if (!fs.existsSync(localeDir)) {
  console.log('No locale directory, skipping locale overrides.');
  process.exit(0);
}

for (const file of fs.readdirSync(overridesDir)) {
  if (path.extname(file) !== '.json') continue;

  const overrides = JSON.parse(
    fs.readFileSync(path.join(overridesDir, file), 'utf8'),
  );
  const targetPath = path.join(localeDir, file);
  const upstream = fs.existsSync(targetPath)
    ? JSON.parse(fs.readFileSync(targetPath, 'utf8'))
    : {};

  const merged = { ...upstream, ...overrides };
  fs.writeFileSync(targetPath, JSON.stringify(merged, null, 2) + '\n');
  console.log(
    `Applied ${Object.keys(overrides).length} overrides to ${file} (${Object.keys(merged).length} keys).`,
  );
}
